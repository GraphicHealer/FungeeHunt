generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id                     String         @id @default(cuid())
  code                   String         @unique
  name                   String
  status                 GameStatus     @default(NOT_STARTED)
  startAt                DateTime?
  endAt                  DateTime?
  liveAt                 DateTime?
  submissionMode         SubmissionMode @default(AUTOMATIC)
  viewerEnabled          Boolean        @default(false)
  returnBonusEnabled     Boolean        @default(false)
  returnStart            DateTime?
  returnEnd              DateTime?
  returnPoints           Float          @default(0)
  bonusStart             DateTime?
  bonusEnd               DateTime?
  foodDriveEnabled            Boolean        @default(false)
  foodDrivePointsPerItem      Float          @default(0)
  foodDrivePermissible        String?
  foodDriveSuggested          String?
  captainCanUpdateFoodDrive   Boolean        @default(true)
  recapVideoStatus       RecapVideoStatus @default(PENDING)
  recapVideoUrl          String?
  players                Player[]
  teams                  Team[]
  tasks                  Task[]
  rulesSections          RuleSection[]
  spectatorSessions      SpectatorSession[]
}

model Player {
  id           String     @id @default(cuid())
  gameId       String
  displayName  String
  type         PlayerType
  hasCar       Boolean    @default(false)
  sessionToken String?    @unique
  joinedAt     DateTime   @default(now())
  game         Game       @relation(fields: [gameId], references: [id])
  team         Team?      @relation(fields: [teamId], references: [id])
  teamId       String?
  managerOf    Team?      @relation("TeamManager")
}

model Team {
  id                    String       @id @default(cuid())
  gameId                String
  name                  String?
  managerId             String?      @unique
  manager               Player?      @relation("TeamManager", fields: [managerId], references: [id])
  members               Player[]
  submissions           Submission[]
  game                  Game         @relation(fields: [gameId], references: [id])
  returnedAt            DateTime?
  returnBonusAwarded    Boolean      @default(false)
  foodDriveItems        Int          @default(0)
  foodDriveBonusAwarded Boolean      @default(false)
}

model Task {
  id          String       @id @default(cuid())
  gameId      String
  title       String
  description String
  points      Float
  proofType   ProofType
  photoCount   Int?
  delayMinutes Int?
  isBonus      Boolean      @default(false)
  category     String?
  order        Int
  game        Game         @relation(fields: [gameId], references: [id])
  submissions Submission[]
}

model Submission {
  id          String           @id @default(cuid())
  taskId      String
  teamId      String
  proofUrl    String
  proofUrls   String[]         @default([])
  status      SubmissionStatus
  isHighlight Boolean          @default(false)
  reason      String?
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?
  task        Task             @relation(fields: [taskId], references: [id])
  team        Team             @relation(fields: [teamId], references: [id])

  @@unique([taskId, teamId])
}

model SpectatorSession {
  id        String   @id @default(cuid())
  code      String   @unique
  gameId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game?    @relation(fields: [gameId], references: [id])
}

model RuleSection {
  id     String @id @default(cuid())
  gameId String
  title  String
  body   String
  game   Game   @relation(fields: [gameId], references: [id])
}

model StyleProfile {
  id          String  @id @default(cuid())
  category    String  @unique
  musicPath   String?
  transitions String[]
  photoHold   Float   @default(2.5)
  energy      String  @default("medium")
  font        String  @default("Arial")
  textColor   String  @default("#ffffff")
  overlay     String  @default("lower_third")
}

model SystemSettings {
  id                       String  @id @default(cuid())
  foodDriveEnabled            Boolean @default(true)
  foodDrivePointsPerItem      Float   @default(1)
  foodDrivePermissible        String?
  foodDriveSuggested          String?
  captainCanUpdateFoodDrive   Boolean @default(true)
  returnBonusEnabled       Boolean @default(true)
  returnBonusWindowMinutes Int     @default(10)
  returnBonusPoints        Float   @default(100)
  randomizeReturnBonus     Boolean @default(false)
  welcomeShown             Boolean @default(false)
  tourStep                 Int     @default(0)
  tourDone                 Boolean @default(false)
  defaultRules             String?
  defaultTasks             String?
  taskCategories           String?
}

enum GameStatus {
  NOT_STARTED
  LIVE
  COMPLETED
}

enum PlayerType {
  APP
  OFFLINE
}

enum ProofType {
  PHOTO
  VIDEO
  PHOTOS
}

enum SubmissionMode {
  AUTOMATIC
  MANUAL
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  COMPLETED
  INCOMPLETE
}

enum RecapVideoStatus {
  PENDING
  RENDERING
  READY
  FAILED
}
