# Identity / branding
PUBLIC_URL=https://hunt.example.com

# Game Master access
GM_PASSPHRASE=changeme

# Database
# Use 'postgres' when running the included compose stack, or 'localhost' for an external DB in Unraid, etc.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fungeehunt
POSTGRES_USER=fungeehunt
POSTGRES_PASSWORD=changeme

# Prisma connection string
DATABASE_URL=postgresql://fungeehunt:changeme@postgres:5432/fungeehunt

# Auth
SESSION_SECRET=changeme

# Port
API_PORT=3000

# Media storage
UPLOAD_DIR=/data/uploads
